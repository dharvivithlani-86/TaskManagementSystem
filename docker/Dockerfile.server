# Stage 1: Build .NET 10 Web API
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["TaskManagement.Server/TaskManagement.Server.csproj", "TaskManagement.Server/"]
RUN dotnet restore "TaskManagement.Server/TaskManagement.Server.csproj"

COPY . .
WORKDIR "/src/TaskManagement.Server"
RUN dotnet build "TaskManagement.Server.csproj" -c Release -o /app/build
RUN dotnet publish "TaskManagement.Server.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Stage 2: Production Runtime
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:80
EXPOSE 80
ENTRYPOINT ["dotnet", "TaskManagement.Server.dll"]
